.nav,
.nav-home
	> .list
		list-style: none
		margin: 0
		padding: 0 13px 0

		> .item
			display: inline-block
			margin: 0 4px

		> .item > .link
			display: inline-block
			font-weight: $thin-font
			font-size: 1.4rem
			padding: 20px 10px
			text-decoration: none
			border-bottom: 2px solid transparent
			transition: border-color .15s ease, color .15s ease

		> .item > .link:hover
			border-color: $delta

.nav
	position: absolute
	right: 0
	top: 0

	> .list
		padding: 0 13px 0

		> .item > .link
			font-size: 1.4rem
			padding: 20px 10px

.nav-home
	margin-top: 40px
	text-align: center

	> .list
		padding: 0

		> .item > .link
			font-size: 2rem
			padding: 7px 15px
			margin: 0
			border-radius: 4%
			transition: all .4s ease-in-out
			width: 70px

			&:hover
				color: $alpha 