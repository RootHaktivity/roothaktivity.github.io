.site-grid-overlay
	position: fixed
	pointer-events: none
	top: 0
	left: 0
	right: 0
	bottom: 0
	z-index: 0
	background-image: linear-gradient(to right, rgba(0,0,0,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.035) 1px, transparent 1px)
	background-size: 24px 24px, 24px 24px

body
	position: relative

// Elevate content above overlay
.wrapper-normal,
.wrapper-large
	position: relative
	z-index: 1

// Monospace accents for a hacker vibe without altering colors
h1, h2, h3, .header-home .title
	letter-spacing: 0.5px
	text-shadow: 0 0 1px rgba(0,0,0,0.25)

code, pre, tt
	box-shadow: 0 0 0 1px rgba(0,0,0,0.04) inset

// Navigation underline scanner
.nav .list .item .link,
.nav-home .list .item .link
	position: relative
	text-decoration: none
	outline: none

.nav .list .item .link::after,
.nav-home .list .item .link::after
	content: ""
	position: absolute
	left: 10px
	right: 10px
	bottom: 12px
	height: 2px
	background: currentColor
	transform: scaleX(0)
	transform-origin: left center
	opacity: .25
	transition: transform .25s ease

.nav .list .item .link:hover::after,
.nav-home .list .item .link:hover::after
	transform: scaleX(1)
	opacity: .35

// Terminal-style caret after page titles
.post .title,
.page .title,
.header-home .title
	position: relative

.post .title::after,
.page .title::after,
.header-home .title::after
	content: "_"
	display: inline-block
	margin-left: 6px
	font-family: $fontMonospace
	animation: caretBlink 1.25s steps(1, end) infinite
	opacity: .8
	transform: translateY(1px)

@keyframes caretBlink
	0%, 49%
		opacity: 0
	50%, 100%
		opacity: 1

// Card-like containers for posts and pages
.page,
.post
	background: rgba(0,0,0,0.015)
	border: 1px solid rgba(0,0,0,0.06)
	border-radius: 10px
	box-shadow: 0 10px 24px rgba(0,0,0,0.06)
	padding: 18px 18px

// Subtle hover glow for images and links
img,
.title-image,
.header-home .selfie
	transition: box-shadow .25s ease, transform .2s ease

img:hover,
.title-image:hover,
.header-home .selfie:hover
	box-shadow: 0 0 0 1px rgba(0,0,0,0.05), 0 12px 32px rgba(0,0,0,0.14)
	transform: translateY(-1px)

// Improve code blocks without color changes
pre
	border-radius: 10px
	border-color: rgba(0,0,0,0.07)
	box-shadow: 0 6px 18px rgba(0,0,0,0.06)

// Tag chips slight techy style
.post-tags .item
	font-family: $fontMonospace
	border: 1px dashed rgba(0,0,0,0.2)
	padding: 2px 8px
	border-radius: 6px

// Footer and small meta text subtle mono accent
.date,
.footer
	font-family: $fontMonospace
	letter-spacing: 0.2px

// Add the grid overlay element via pseudo to body without touching HTML
body::before
	content: ""
	position: fixed
	inset: 0
	z-index: 0
	pointer-events: none
	background-image: linear-gradient(to right, rgba(0,0,0,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.035) 1px, transparent 1px)
	background-size: 24px 24px, 24px 24px

// Reduce motion preference
@media (prefers-reduced-motion: reduce)
	.nav .list .item .link::after,
	.nav-home .list .item .link::after,
	.header-home .title::after
		animation: none
		transition: none 